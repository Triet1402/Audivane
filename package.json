{
  "name": "codec-abx-workspace",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ts": "node --import tsx --test packages/*/test/*.test.ts",
    "check:ts": "npm run typecheck && npm run test:ts",
    "assets:copy": "node tools/copy-wasm-assets.mjs",
    "check:native": "node --import tsx packages/engine-native/src/typescript/readiness-cli.ts",
    "dev": "npm run assets:copy && vite --config apps/client/vite.config.ts",
    "build:client": "node tools/verification/build.mjs client",
    "preview:client": "vite preview --config apps/client/vite.config.ts",
    "test:browser": "node tools/test-browser.mjs",
    "build:desktop": "node tools/build-desktop.mjs",
    "desktop": "node tools/launch-desktop.mjs",
    "package:desktop": "node tools/package-desktop.mjs",
    "package:desktop:win": "node tools/package-desktop.mjs --platform win32 --require-native-bundle",
    "dist:check": "node tools/distribution/check.mjs",
    "dist:linux": "node tools/distribution/release.mjs linux",
    "dist:arch": "node tools/distribution/release.mjs arch",
    "dist:windows": "node tools/distribution/release.mjs windows",
    "dist:verify": "node tools/distribution/release.mjs verify",
    "icons:export": "node tools/distribution/export-icons.mjs",
    "test:distribution": "node --test tools/test/distribution.test.mjs",
    "test:desktop": "node tools/test-desktop.mjs",
    "test:unit": "node tools/test-unit.mjs",
    "setup:virtual-audio": "node tools/setup-virtual-audio.mjs",
    "test:audio-output": "node tools/test-audio-output.mjs",
    "test:tooling": "node --test tools/test/*.test.mjs",
    "test:desktop:unit": "node --import tsx --test apps/desktop/test/*.test.ts",
    "test:windows-lifetime": "node --test tools/test/windows-process-lifetime.mjs",
    "test:production:unit": "node tools/test-production.mjs unit",
    "test:production:browser": "node tools/test-production.mjs browser",
    "test:production:desktop": "node tools/test-production.mjs desktop",
    "test:production": "node tools/test-production.mjs",
    "test:performance": "node tools/test-desktop.mjs --performance",
    "profile:browser": "node tools/profile-browser-isolated.mjs",
    "verify:quick": "node tools/verify.mjs quick",
    "verify:production": "node tools/verify.mjs production",
    "verify:full": "node tools/verify.mjs full"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
