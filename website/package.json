{
  "name": "audivane-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "build:content": "astro build",
    "build:demo": "node scripts/build-demo.mjs",
    "package:sources": "node scripts/package-sources.mjs",
    "publish:local": "node scripts/publish-local.mjs",
    "start": "node scripts/serve.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "typecheck": "astro sync && tsc --noEmit -p tsconfig.json",
