---
const links = [
  { href: "/docs/", label: "Docs" },
  { href: "/guides/", label: "Guides" },
  { href: "/downloads/", label: "Downloads" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || (path !== "/" && path.startsWith(href));
---

<a class="skip" href="#main">Skip to content</a>
<header class="masthead wrap">
  <a class="brand" href="/" aria-label="Audivane home">
    <img src="/mark.svg" width="34" height="34" alt="" />
    Audivane
  </a>
  <nav aria-label="Main navigation">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
    <a class="nav-app" href="/demo/">Demo</a>
  </nav>
  <label class="theme-picker" for="site-theme">
    <span>Theme</span>
    <select id="site-theme" name="theme">
      <option value="system">System</option>
      <option value="light">Daylight</option>
      <option value="dark">Midnight</option>
      <option value="studio">Studio</option>
    </select>
  </label>
</header>
