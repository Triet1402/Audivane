---
interface Props {
  title: string;
  description: string;
  /** Content pages use og:type article; everything else website. */
  ogType?: "website" | "article";
  /** Reserved for any future page that must stay out of search. */
  noindex?: boolean;
}
const { title, description, ogType = "website", noindex = false } = Astro.props;

const site = Astro.site ?? new URL("https://audivane.app/");
const rawPath = Astro.url.pathname;
const canonical = new URL(
  rawPath === "/" || rawPath.endsWith("/") ? rawPath : `${rawPath}/`,
  site,
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f1f2f5" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1e1f22" media="(prefers-color-scheme: dark)" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content="Audivane" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content="en" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<link rel="icon" href="/mark.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
