---
import BaseLayout from "../layouts/BaseLayout.astro";
const release = "https://github.com/Triet1402/Audivane/releases/tag/0.2.2";
const assets = "https://github.com/Triet1402/Audivane/releases/download/0.2.2";
---

<BaseLayout
  title="Downloads — Audivane"
  description="Current Audivane download availability by platform. Download version 0.2.2 for Linux and Windows with SHA-256 checksums, source materials and known testing limits."
>
  <div class="section-head wrap">
    <h1>Downloads</h1>
    <p class="lead">
      Download Audivane 0.2.2 for Linux or Windows, or use the
      <a href="/demo/">browser app</a> now. Audio processing stays on your device.
    </p>
  </div>

  <div class="downloads wrap">
    <section aria-labelledby="ready-title">
      <h2 id="ready-title">Availability by platform</h2>
      <table>
        <caption class="visually-hidden">
          Audivane 0.2.2 download availability by platform as of November 2026
        </caption>
        <thead>
          <tr><th scope="col">Platform</th><th scope="col">Status</th><th scope="col">Download</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Linux x64 (Ubuntu 24.04 baseline)</th>
            <td>Available</td>
            <td><a href={`${assets}/audivane_0.2.2_amd64.deb`}>Download .deb</a></td>
          </tr>
          <tr>
            <th scope="row">Arch x86_64</th>
            <td>Available</td>
            <td><a href={`${assets}/audivane-bin-0.2.2-1-x86_64.pkg.tar.zst`}>Download Arch package</a></td>
          </tr>
          <tr>
            <th scope="row">Windows x64</th>
            <td>Available — unsigned builds</td>
            <td><a href={`${assets}/Audivane-Setup-0.2.2-x64.exe`}>Download installer</a><br /><a href={`${assets}/Audivane-0.2.2-win32-x64.zip`}>Download portable ZIP</a></td>
          </tr>
          <tr>
            <th scope="row">macOS</th>
            <td>Not planned for 0.2.2</td>
            <td>—</td>
          </tr>
          <tr>
            <th scope="row">Browser app</th>
            <td>Available</td>
            <td><a href="/demo/">Open the browser app</a></td>
          </tr>
        </tbody>
      </table>
    </section>

    <p>
      Every download ships with <a href={`${assets}/SHA256SUMS.txt`}>SHA-256 checksums</a>,
      matching <a href={release}>source, codec materials and build scripts</a>,
      and its recorded testing limits. Windows builds are unsigned, and
      installed-platform and physical listening coverage is incomplete —
      see the <a href="/docs/release-status/">release status</a>.
    </p>
  </div>
</BaseLayout>
